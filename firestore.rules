rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Active guided rerun. Keep this literal path so the live study does not
    // depend on a broad studyId wildcard when security rules are evaluated.
    match /studies/requester-minimal-pairs-v3-pilot-guided-20260719/participants/{userId} {
      allow create, read, update: if request.auth != null
                                  && request.auth.uid == userId;
      allow delete: if false;

      match /responses/{caseId} {
        allow create, read, update: if request.auth != null
                                    && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    match /studies/{studyId}/participants/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /responses/{caseId} {
        allow create, read, update: if request.auth != null
                                    && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // Legacy pilot path retained read/write-compatible so old results remain archived.
    match /participants/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /responses/{caseId} {
        allow create, read, update: if request.auth != null
                                    && request.auth.uid == userId;
        allow delete: if false;
      }
    }
  }
}
